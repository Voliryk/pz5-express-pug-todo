doctype html
html(lang='uk')
  head
    meta(charset='utf-8')
    title #{title} - To-Do App
    style.
      body { font-family: 'Segoe UI', Arial, sans-serif; max-width: 640px; margin: 40px auto; color: #333; }
      h1 { color: #4a78d4; }
      li { padding: 6px 0; font-size: 18px; }
      .done { text-decoration: line-through; color: #999; }
      .badge { font-size: 12px; color: #1a7f37; font-weight: bold; margin-left: 8px; }
  body
    block content
